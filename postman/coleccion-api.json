{
  "info": {
    "name": "API Productos",
    "description": "Colección para probar la API de productos. Haz login primero: el token se guarda solo en la variable {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "registro (usuario)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registro"
              ]
            },
            "description": "201 si todo está bien. 400 con { errores: { campo: mensaje } } si hay datos inválidos o el email ya existe.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@correo.com\",\n  \"password\": \"1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "registro (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@correo.com\",\n  \"password\": \"1234\",\n  \"rol\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "registro (con errores)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registro"
              ]
            },
            "description": "Debe responder 400 con un error por cada campo.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "200 con { token }. El token se guarda solo en la variable {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@correo.com\",\n  \"password\": \"1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "login (con errores)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Debe responder 400 con errores en email y password.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "get listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "description": "200. Público.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "get id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "1"
              ]
            },
            "description": "200 o 404. Público.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "description": "201. Requiere token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teclado\",\n  \"precio\": 80000,\n  \"stock\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "post (con errores)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos"
              ]
            },
            "description": "Debe responder 400 con errores en nombre, precio y stock.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "put",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "1"
              ]
            },
            "description": "200, 400 o 404. Requiere token y los tres campos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teclado gamer\",\n  \"precio\": 95000,\n  \"stock\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "patch",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "1"
              ]
            },
            "description": "200, 400 o 404. Requiere token. Basta con un campo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "productos",
                "1"
              ]
            },
            "description": "204 sin body, 404 si no existe, 403 si el token no es de admin."
          }
        }
      ]
    }
  ]
}